# Copiar a .env.local (ignorado por git) y a las variables de entorno del hosting.
# Sin estas variables el sitio funciona igual, solo deja de guardar las solicitudes.

VITE_SUPABASE_URL=
# Llave publishable (sb_publishable_...). Es pública por diseño: viaja en el bundle
# del navegador y quien protege los datos es RLS, no el secreto de la llave.
VITE_SUPABASE_PUBLISHABLE_KEY=
